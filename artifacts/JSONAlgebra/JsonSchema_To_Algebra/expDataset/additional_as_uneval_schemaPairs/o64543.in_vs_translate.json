          "type": "string"
        },
        "_rev": {
          "description": "Internal revision",
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "collection": {
          "type": "string",
          "default": "ny-\u00e5lesund"
        },
        "updated_by": {
          "type": "string"
        }
      }
