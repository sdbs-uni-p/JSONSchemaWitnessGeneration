          ]
        }
      },
      "required": [
        "code",
        "isElective",
        "electiveType"
      ],
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/definitions4/electiveCourse"
    },
    {
      "$ref": "#/definitions4/regularCourse"
    },
    {
      "$ref": "#/definitions3/electiveCourse"
    },
    {
