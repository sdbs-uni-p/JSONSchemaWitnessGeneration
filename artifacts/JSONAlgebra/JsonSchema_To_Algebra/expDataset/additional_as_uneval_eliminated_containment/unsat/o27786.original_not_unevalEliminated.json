        }
      },
      "required": [
        "default"
      ]
    },
    "VRTid": {
      "type": "string",
      "pattern": "^[a-z_]*$"
    },
    "CVSSv3": {
      "type": "string",
      "pattern": "^AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$"
    },
    "Mapping": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions3/VRTid"
        },
        "cvss_v3": {
          "$ref": "#/definitions3/CVSSv3"
        }
      },
      "required": [
        "id",
        "cvss_v3"
      ],
      "additionalProperties": false
    },
    "MappingParent": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions3/VRTid"
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
