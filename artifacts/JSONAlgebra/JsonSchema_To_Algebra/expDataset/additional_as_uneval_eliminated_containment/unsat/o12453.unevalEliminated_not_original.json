    "boundingBox": {
      "type": "object",
      "description": "The active area (both pipettes can reach) of a fixture on the deck",
      "required": [
        "xDimension",
        "yDimension",
        "zDimension"
      ],
      "properties": {
        "xDimension": {
          "$ref": "#/definitions4/positiveNumber"
        },
        "yDimension": {
          "$ref": "#/definitions4/positiveNumber"
        },
        "zDimension": {
          "$ref": "#/definitions4/positiveNumber"
        }
      }
    },
    "xyzArray": {
      "type": "array",
      "description": "Array of 3 numbers, [x, y, z]",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "unitVector": {
      "type": "array",
      "description": "Array of 3 unit directions, [x, y, z]",
      "items": {
        "type": "number",
        "enum": [
          1,
          -1
        ]
      },
      "minItems": 3,
      "maxItems": 3
    },
