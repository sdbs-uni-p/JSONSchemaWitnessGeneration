          "type": "string"
        },
        "projectType": {
          "description": "Project type.",
          "enum": [
            "application",
            "library"
          ],
          "type": "string"
        },
        "root": {
          "description": "Root of the project sourcefiles.",
          "type": "string"
        },
        "schematics": {
          "$ref": "#/definitions3/tool",
          "default": {}
        },
        "sourceRoot": {
          "description": "The root of the source files, assets and index.html file structure.",
          "type": "string"
        },
        "targets": {
          "$ref": "#/definitions3/tool",
          "default": {}
        }
      },
      "required": [
