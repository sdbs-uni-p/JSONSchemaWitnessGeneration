            "mimecrc",
            "mimetype",
            "version"
          ],
          "properties": {
            "mimecrc": {
              "$ref": "#/definitions2/crc32Type",
              "description": "CRC32 of mimetype"
            },
            "mimetype": {
              "type": "string",
              "pattern": "^application/x-metacatalog-(tape|cartridge|disk)$"
            },
            "version": {
              "type": "string",
