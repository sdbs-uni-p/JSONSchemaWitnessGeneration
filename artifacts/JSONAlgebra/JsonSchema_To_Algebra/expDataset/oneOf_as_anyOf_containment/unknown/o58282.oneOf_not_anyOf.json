          "default": true,
          "type": "boolean"
        },
        "matchBrackets": {
          "default": true,
          "type": "boolean"
        },
        "mode": {
          "default": "javascript",
          "type": "string"
        },
        "styleActiveLine": {
          "default": true,
          "type": "boolean"
        },
        "theme": {
          "default": "monokai",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Path": {
      "description": "Default download save path",
      "oneOf": [
        {
          "enum": [
            "home",
            "temp",
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "videos"
          ],
          "resolve": true,
          "type": "string",
          "_uniqueItems": true
        },
        {
          "exists": {
            "root": "/",
            "type": "isDirectory"
          },
          "format": "path",
          "type": "string"
        }
      ]
    },
    "PlayList": {
      "description": "PlayList options",
      "properties": {
        "current": {
