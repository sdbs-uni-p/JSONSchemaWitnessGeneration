            "rebel",
            "imperial",
            "scum"
          ],
          "type": "string"
        },
        "name": {
          "description": "The name of the squadron.",
          "type": "string"
        },
        "obstacles": {
          "description": "Array of three Strings, each being an identifier for the obstacle chosen for tournament use.",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "pilots": {
          "description": "The members of this squadron.",
          "items": {
            "additionalProperties": {
              "not": {}
            },
            "minItems": 1,
