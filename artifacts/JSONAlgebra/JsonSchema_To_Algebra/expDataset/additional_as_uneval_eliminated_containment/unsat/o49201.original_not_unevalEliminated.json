  "definitions3": {
    "size": {
      "$id": "#/definitions3/size",
      "type": "object",
      "title": "Size Schema",
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "integer",
          "title": "width",
          "default": 0,
          "examples": [
            640
          ]
        },
        "h": {
          "type": "integer",
          "title": "height",
          "default": 0,
          "examples": [
            480
