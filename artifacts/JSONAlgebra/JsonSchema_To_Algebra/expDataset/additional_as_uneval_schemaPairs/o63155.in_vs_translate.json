                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "description": "Explains which shells are/aren't compatible with this invocation.",
                "type": "object"
              },
              "shibboleths": {
                "description": "",
                "items": {
                  "additionalProperties": {
                    "not": {}
                  },
                  "properties": {
                    "comment": {
                      "type": "string"
                    },
