      "description": "JSON Schema for deck layout description",
      "type": "object",
      "required": [
        "before",
        "after",
        "new_ids",
        "version"
      ],
      "properties": {
        "version": {
          "description": "the version of this schema for validation",
          "const": "1.0"
        },
        "before": {
          "$ref": "#/definitions4/deckSummary"
        },
        "after": {
          "$ref": "#/definitions4/deckSummary"
        },
        "new_ids": {
          "$ref": "#/definitions4/modern_12"
        }
      }
    },
    {
      "not": {
        "$id": "https://antha.com/layout-schema",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "JSON Schema for deck layout description",
        "type": "object",
        "required": [
          "before",
          "after",
          "new_ids",
          "version"
        ],
        "properties": {
          "version": {
            "description": "the version of this schema for validation",
            "const": "1.0"
          },
          "before": {
            "$ref": "#/definitions3/deckSummary"
          },
          "after": {
            "$ref": "#/definitions3/deckSummary"
          },
          "new_ids": {
            "type": "object",
            "description": "maps from the object IDs in 'before' to 'after'",
            "additionalProperties": {
              "type": "string",
              "description": "An ID in 'after'"
            }
          }
        }
      }
    }
  ],
  "definitions4": {
    "plate": {
