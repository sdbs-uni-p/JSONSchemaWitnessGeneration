      "type": "object",
      "properties": {
        "value": {
          "title": "Value",
          "description": "Value to be stored in the database",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "label": {
          "title": "Label",
          "description": "User-friendly label",
          "type": "string",
          "minLength": 1
        },
        "inactive": {
          "title": "Inactive",
          "description": "Whether or not the item is active",
          "type": "boolean",
          "default": false
        },
        "children": {
          "title": "List item children",
