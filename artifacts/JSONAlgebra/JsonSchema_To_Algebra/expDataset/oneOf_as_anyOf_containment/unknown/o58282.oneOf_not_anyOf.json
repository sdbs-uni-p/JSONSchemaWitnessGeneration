    },
    "Preset": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "quality",
            "format"
          ]
        },
        {
          "required": [
            "bitrate",
            "format"
          ]
        }
      ],
      "description": "Transcode preset",
      "properties": {
        "bitrate": {
          "default": 128,
          "description": "Audio bitrate in kbps",
          "maximum": 320,
          "minimum": 32,
          "type": "number"
        },
        "channels": {
          "default": 2,
          "description": "Audio channel count",
          "maximum": 99,
          "minimum": 1,
          "type": "number"
        },
        "codec": {
          "description": "Audio codec name",
          "type": "string"
        },
        "format": {
          "description": "Audio output format",
          "enum": [
            "aac",
            "mp3",
            "mp4",
            "wav",
            "webm",
            "mpeg"
          ],
          "type": "string"
        },
        "frequency": {
          "default": 44100,
          "description": "Audio frequency in Hz",
          "enum": [
            8000,
            11025,
            12000,
            16000,
            22050,
            24000,
            32000,
            44100,
            48000
          ],
          "maximum": 48000,
          "minimum": 8000,
          "type": "number"
        },
        "options": {
          "description": "Custom output options",
          "type": "string"
        },
        "quality": {
          "default": 1,
          "description": "Audio quality factor",
          "maximum": 32767,
          "minimum": 1,
          "type": "number"
        }
      },
      "type": "object"
    },
    "Provider": {
      "description": "Service provider",
      "properties": {
