                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "vendor": {
                "description": "An extensible object containing app-specific data. Developers should put extra data here under their own namespace.",
                "maxProperties": 1,
                "minProperties": 1,
                "type": "object"
              }
            },
            "required": [
              "name",
              "ship"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "points": {
          "description": "The total points spent creating this squadron.",
          "type": "integer"
        },
        "vendor": {
          "description": "An extensible object containing app-specific data. Developers should put extra data here under their own namespace.",
          "maxProperties": 1,
