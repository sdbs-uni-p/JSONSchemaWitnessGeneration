                },
                "idleCurrent": {
                  "$ref": "#/definitions4/idleCurrentRange"
                },
                "dropTipSpeed": {
                  "$ref": "#/definitions4/editConfigurations"
                },
                "pickUpDistance": {
                  "$ref": "#/definitions4/editConfigurations"
                },
                "modelOffset": {
                  "$ref": "#/definitions4/xyzArray"
                },
                "blowout": {
                  "$ref": "#/definitions4/editConfigurations"
                },
                "tipOverlap": {
                  "$ref": "#/definitions4/modern_4"
                },
                "pickUpIncrement": {
                  "$ref": "#/definitions4/editConfigurations"
                },
                "bottom": {
                  "$ref": "#/definitions4/editConfigurations"
                },
                "pickUpCurrent": {
                  "$ref": "#/definitions4/editConfigurations"
                },
                "dropTipCurrent": {
                  "$ref": "#/definitions4/editConfigurations"
                },
                "returnTipHeight": {
