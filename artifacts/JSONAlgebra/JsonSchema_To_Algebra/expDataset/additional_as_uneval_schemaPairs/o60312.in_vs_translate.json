              "type": "integer"
            },
            "timeout": {
              "default": 30,
              "description": "Mesos HTTP API timeout",
              "minimum": 1,
              "type": "integer"
            },
            "watch": {
              "default": true,
              "description": "Watch changes in Marathon.",
              "type": "boolean"
            },
            "zk-timeout": {
              "default": 30,
              "description": "ZooKeeper timeout",
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
