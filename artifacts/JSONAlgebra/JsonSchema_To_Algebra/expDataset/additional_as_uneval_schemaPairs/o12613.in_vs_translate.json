              "type": "string",
              "description": "Name of chute service which provides the web service."
            },
            "port": {
              "type": "integer",
              "description": "Listening port inside the chute.",
              "minimum": 1,
              "maximum": 65536
            }
          },
          "additionalProperties": {
            "not": {}
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": {
        "not": {}
      }
