                  "delegated",
                  "consistent",
                  "default",
                  "ro"
                ],
                "type": "string"
              },
              "type": {
                "description": "Type of volume mount",
                "enum": [
                  "cache"
                ],
                "type": "string"
              }
            },
            "required": [
              "type",
              "name",
              "container"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    }
