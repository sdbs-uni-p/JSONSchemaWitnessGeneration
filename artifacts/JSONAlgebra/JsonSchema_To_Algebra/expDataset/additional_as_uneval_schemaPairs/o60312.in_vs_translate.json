            },
            "watch-config-file": {
              "default": true,
              "description": "Watch config file for changes.",
              "type": "boolean"
            },
            "write-timeout": {
              "default": "0s",
              "description": "The maximum duration before timing out writes of the response",
              "type": "string"
            }
