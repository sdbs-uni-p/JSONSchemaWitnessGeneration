{
  "allOf": [
    {
      "id": "https://tredly.com/docs/tredlyfile-json-schema#",
      "$schema": "http://json-schema.org/draft-04/schema#",
      "description": "schema for an JSON Tredlyfile",
      "type": "object",
      "required": [
        "container"
      ],
      "properties": {
        "container": {
          "type": "object",
          "properties": {
            "name": {
              "description": "Unique per partition. Hostname of this container will this value",
              "type": "string",
              "pattern": "^[-_a-zA-Z0-9]+$"
            },
            "restrictTo": {
              "description": "The version of Tredly this file is compatible with.",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(\\*|[0-9](?:\\.(\\*|[0-9]{1,}(?:\\.(\\*|[0-9]{1,}))?)?)?)$"
                },
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 0
                }
              ]
            },
            "group": {
              "description": "Add this container to a particular group.",
              "optional": true,
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[-_a-zA-Z0-9]+$"
                },
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 0
                }
              ]
            },
            "startOrder": {
              "description": "Order in which this container is started within your container group.",
              "type": "integer",
              "minimum": 1,
              "maximum": 99,
              "default": 1
            },
            "replicate": {
              "description": "When set to yes, this allows a container to be replicated within its container group. This is required if 'group' has been set.",
              "type": "boolean",
              "default": false
            },
            "buildOptions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "publish": {
                  "description": "When set to true, on push to a Tredly host this container will be automatically validated and built.",
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "publish"
              ]
            },
            "technicalOptions": {
              "description": "These options will be set when the container is created.",
              "type": "object",
              "optional": true,
              "additionalProperties": false,
              "properties": {
                "securelevel": {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 3
                },
                "devfs_ruleset": {
                  "$ref": "#/definitions4/positiveInteger"
                },
                "enforce_statfs": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "children.max": {
                  "$ref": "#/definitions4/positiveInteger"
                },
                "allow.set_hostname": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.sysvipc": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.raw_sockets": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.chflags": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.mount": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.mount.devfs": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.mount.nullfs": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.mount.procfs": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.mount.tmpfs": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.mount.zfs": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.quotas": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "allow.socket_af": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "exec.prestart": {
                  "$ref": "#/definitions4/stringPath"
                },
                "exec.poststart": {
                  "$ref": "#/definitions4/stringPath"
                },
                "exec.prestop": {
                  "$ref": "#/definitions4/stringPath"
                },
                "exec.stop": {
                  "$ref": "#/definitions4/stringPath"
                },
                "exec.clean": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "exec.timeout": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "exec.fib": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "stop.timeout": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "mount.devfs": {
                  "$ref": "#/definitions4/binaryStringType"
                },
                "mount.fdescfs": {
                  "$ref": "#/definitions4/binaryStringType"
                }
              }
            },
            "persistentStorage": {
              "type": "object",
              "optional": true,
              "description": "Create a persistent block of storage for this container",
              "additionalProperties": false,
              "properties": {
                "identifier": {
                  "description": "A unique name to identify this block of persistent storage.",
                  "type": "string",
                  "pattern": "^[-_a-zA-Z0-9]+$"
                },
                "mountPoint": {
                  "description": "The path within the container that the persistent storage will be mounted.",
                  "$ref": "#/definitions4/stringPath"
                }
              },
              "required": [
                "identifier",
                "mountPoint"
              ]
            },
            "resourceLimits": {
              "description": "Limit resources used by this container.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxCpu": {
                  "description": "The total number of cores or percent this container can utilise.",
                  "optional": true,
                  "default": "unlimited",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "$ref": "#/definitions4/resourceUnlimited"
                    }
                  ]
                },
                "maxHdd": {
                  "description": "The total amount of disk space, in Gigabytes (G) or Megabytes (M), this container.",
                  "optional": true,
                  "default": "unlimited",
                  "anyOf": [
                    {
                      "$ref": "#/definitions4/typeSizeMegabyte"
                    },
                    {
                      "$ref": "#/definitions4/typeSizeGigabyte"
                    },
                    {
                      "$ref": "#/definitions4/resourceUnlimited"
                    }
                  ]
                },
                "maxRam": {
                  "description": "The total amount of RAM, in Gigabytes (G) or Megabytes (M), this container can utilise.",
                  "optional": true,
                  "default": "unlimited",
                  "anyOf": [
                    {
                      "$ref": "#/definitions4/typeSizeMegabyte"
                    },
                    {
                      "$ref": "#/definitions4/typeSizeGigabyte"
                    },
                    {
                      "$ref": "#/definitions4/resourceUnlimited"
                    }
                  ]
                }
              }
            },
            "proxy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "layer4Proxy": {
                  "description": "Layer4 proxy allows the container to use the Hosts external IP and forward traffic to your container on specific ports.",
                  "type": "boolean",
                  "default": false
                },
                "layer7Proxy": {
                  "description": "Group of properties for URL(s) the container services and responds to.",
                  "optional": true,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "cert": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "enableWebsocket": {
                        "optional": true,
                        "type": "boolean",
                        "default": false
                      },
                      "errorResponse": {
                        "type": "boolean",
                        "default": true
                      },
                      "maxFileSize": {
                        "type": "string",
                        "optional": true,
                        "pattern": "^[0-9]+(m|g)$",
                        "default": "1m"
                      },
                      "redirects": {
                        "type": "array",
                        "optional": true,
                        "items": {
                          "type": "object",
                          "anyOf": [
                            {
                              "$ref": "#/definitions4/httpRedirect"
                            },
                            {
                              "$ref": "#/definitions4/httpsRedirect"
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "url",
                      "cert"
                    ]
                  }
                }
              },
              "required": [
                "layer4Proxy"
              ]
            },
            "firewall": {
              "type": "object",
              "optional": true,
              "properties": {
                "ipv4Whitelist": {
                  "type": "array",
                  "optional": true,
                  "_uniqueItems": true,
                  "default": {},
                  "items": {
                    "$ref": "#/definitions4/validIpv4WithCidr"
                  }
                },
                "allowPorts": {
                  "type": "object",
                  "optional": true,
                  "additionalProperties": false,
                  "_uniqueItems": true,
                  "properties": {
                    "udp": {
                      "$ref": "#/definitions4/inOutPorts"
                    },
                    "tcp": {
                      "$ref": "#/definitions4/inOutPorts"
                    }
                  }
                }
              }
            },
            "customDNS": {
              "type": "array",
              "_uniqueItems": true,
              "optional": true,
              "default": {},
              "items": {
                "$ref": "#/definitions4/validIpv4"
              }
            },
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "onStart": {
                  "$ref": "#/definitions4/arrayOfExecOperationsOnly"
                },
                "onStop": {
                  "$ref": "#/definitions4/arrayOfExecOperationsOnly"
                },
                "onCreate": {
                  "$ref": "#/definitions4/arrayOfOperations"
                },
                "onDestroy": {
                  "$ref": "#/definitions4/arrayOfExecOperationsOnly"
                }
              }
            }
          }
        }
      }
    },
