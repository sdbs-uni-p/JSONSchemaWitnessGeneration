                }
              },
              "$$target": "#/definitions4/service"
            },
            {
              "patternProperties": {
                "^requests$": true,
                "^image$": true,
                "^environment$": true,
                "^type$": true,
                "^dns$": true,
                "^command$": true,
                "^source$": true,
                "^interfaces$": true
              },
              "additionalProperties": false
            }
          ]
