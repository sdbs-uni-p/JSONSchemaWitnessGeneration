{
  "allOf": [
    {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$ref": "#/definitions4/modern_2"
    },
    {
      "not": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "config",
          "mutableConfigs"
        ],
        "properties": {
          "config": {
            "description": "Version-level pipette specifications, which may vary across different versions of the same pipette",
            "type": "object",
            "$comment": "Example key: 'p10_single_v1.3'",
            "patternProperties": {
              ".*": {
                "required": [
                  "name",
                  "top",
                  "bottom",
                  "blowout",
                  "dropTip",
                  "pickUpCurrent",
                  "pickUpDistance",
                  "pickUpIncrement",
                  "pickUpPresses",
                  "pickUpSpeed",
                  "modelOffset",
                  "plungerCurrent",
                  "dropTipCurrent",
                  "dropTipSpeed",
                  "ulPerMm",
                  "tipLength"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "description": "reference to name of this version, should match a key in corresponding pipetteNameSpecs.json file",
                    "type": "string"
                  },
                  "backCompatNames": {
                    "description": "Optional reference for name of backwards compatible pipette corresponding to a key in pipetteNameSpecs.json, only relevant to gen2 pipettes",
                    "type": "array"
                  },
                  "top": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "bottom": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "blowout": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "dropTip": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "pickUpCurrent": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "pickUpDistance": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "pickUpPresses": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "pickUpIncrement": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "pickUpSpeed": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "modelOffset": {
                    "$ref": "#/definitions3/xyzArray"
                  },
                  "plungerCurrent": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "dropTipCurrent": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "dropTipSpeed": {
                    "$ref": "#/definitions3/editConfigurations"
                  },
                  "ulPerMm": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions3/liquidHandlingSpecs"
                    }
                  },
                  "quirks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tipLength": {
                    "type": "object",
                    "value": {
                      "$ref": "#/definitions3/positiveNumber"
                    }
                  },
                  "idleCurrent": {
                    "$ref": "#/definitions3/idleCurrentRange"
                  },
                  "returnTipHeight": {
                    "$ref": "#/definitions3/returnTipHeightRange"
                  },
                  "tipOverlap": {
                    "type": "object",
                    "description": "Map of tip overlap values with defaults",
                    "required": [
                      "default"
                    ],
                    "$comment": "Other keys in here should be labware URIs",
                    "properties": {
                      "default": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "mutableConfigs": {
            "type": "array",
            "description": "Array of mutable configs for a given pipette",
            "items": {
              "type": "string"
            }
          },
          "validQuirks": {
            "type": "array",
            "description": "Array of valid quirks for a given pipette",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "definitions4": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Object containing linear equations for translating between uL of liquid and mm of plunger travel. There is one linear equation for aspiration and one for dispense",
              "type": "object",
              "required": [
                "aspirate",
                "dispense"
              ],
              "properties": {
                "aspirate": {
                  "$ref": "#/definitions4/linearEquations"
                },
                "dispense": {
                  "$ref": "#/definitions4/linearEquations"
                }
              }
            },
            {
              "patternProperties": {
                "^aspirate$": true,
                "^dispense$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "xyzArray": {
      "type": "array",
      "description": "Array of 3 numbers, [x, y, z]",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
