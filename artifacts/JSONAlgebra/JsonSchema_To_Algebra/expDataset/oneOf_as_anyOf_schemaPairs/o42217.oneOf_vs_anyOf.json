[
  {
    "id": 375,
    "schema1": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_]*$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "contexts",
              "attention_levels"
            ],
            "minProperties": 2,
            "maxProperties": 2,
            "properties": {
              "contexts": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-zA-Z][a-zA-Z0-9_]*$": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                }
              },
              "attention_levels": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-zA-Z][a-zA-Z0-9_]*$": {
                    "type": "object",
                    "minProperties": 1,
                    "patternProperties": {
                      "^[a-zA-Z][a-zA-Z0-9_]*$": {
                        "type": "array",
                        "minItems": 1,
                        "_uniqueItems": true,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schema2": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-zA-Z][a-zA-Z0-9_]*$": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "contexts",
              "attention_levels"
            ],
            "minProperties": 2,
            "maxProperties": 2,
            "properties": {
              "contexts": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-zA-Z][a-zA-Z0-9_]*$": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                }
              },
              "attention_levels": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-zA-Z][a-zA-Z0-9_]*$": {
                    "type": "object",
                    "minProperties": 1,
                    "patternProperties": {
                      "^[a-zA-Z][a-zA-Z0-9_]*$": {
                        "type": "array",
                        "minItems": 1,
                        "_uniqueItems": true,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "tests": {
      "s1SubsetEqOfs2": true,
      "s2SubsetEqOfs1": false
    }
  }
]