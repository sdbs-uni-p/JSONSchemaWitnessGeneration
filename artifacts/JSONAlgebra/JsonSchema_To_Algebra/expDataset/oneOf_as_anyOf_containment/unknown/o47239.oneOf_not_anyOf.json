        "hotelId": {
          "type": "string"
        }
      },
      "required": [
        "hotelId"
      ]
    },
    "occupancyRoom": {
      "type": "object",
      "properties": {
        "adults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "children": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 12
              }
            },
            "required": [
              "age"
            ]
          }
        }
      },
      "required": [
        "adults"
      ]
    },
    "destination": {
      "type": "object",
