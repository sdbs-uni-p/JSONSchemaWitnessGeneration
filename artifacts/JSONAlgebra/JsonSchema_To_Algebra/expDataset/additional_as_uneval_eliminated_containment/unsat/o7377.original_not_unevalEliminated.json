            },
            "repo": {
              "type": "string"
            },
            "release": {
              "type": "string"
            }
          },
          "required": [
            "owner",
            "release",
            "repo"
          ]
        },
        "curseforge": {
          "description": "The curseforge info for this source. If this is imported from curseforge, it will present.",
          "$ref": "#/definitions3/CurseforgeSource"
        }
      },
