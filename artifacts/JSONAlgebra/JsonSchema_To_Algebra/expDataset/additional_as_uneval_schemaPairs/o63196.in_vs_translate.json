                        "minimum": 0,
                        "type": "number"
                      },
                      "unit": {
                        "pattern": "pct|ppm|ppb|ppt|ppq|mBq/kg|uBq/kg|nBq/kg",
                        "type": "string"
                      },
                      "isotope": {
