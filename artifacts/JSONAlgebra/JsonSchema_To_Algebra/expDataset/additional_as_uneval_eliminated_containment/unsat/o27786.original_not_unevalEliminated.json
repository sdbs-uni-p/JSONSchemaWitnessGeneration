          "$ref": "#/definitions3/CVSSv3"
        }
      },
      "required": [
        "id",
        "children"
      ],
      "additionalProperties": false
    }
  },
  "definitions4": {
    "CVSSv3": {
      "type": "string",
      "pattern": "^AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/definitions4/VRTid"
                },
                "cvss_v3": {
                  "$ref": "#/definitions4/CVSSv3"
                }
              },
              "required": [
                "id",
                "cvss_v3"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^cvss_v3$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
