      "not": {
        "$id": "https://l2beat.com/config.schema.json",
        "title": "Discovery config",
        "description": "A configuration file for smart contract discovery",
        "type": "object",
        "required": [
          "name",
          "initialAddresses"
        ],
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "type": "string"
          },
          "name": {
            "description": "An identifier for this project",
            "type": "string"
          },
          "chain": {
            "description": "Chain on which to run the discovery on",
            "type": "string",
            "enum": [
              "ethereum",
              "arbitrum",
              "optimism",
              "polygon-pos",
              "bsc",
              "avalanche",
              "celo",
              "linea",
              "base",
              "polygon-zkevm",
              "gnosis"
            ]
          },
          "initialAddresses": {
            "description": "A list of addresses that discovery starts from",
            "type": "array",
            "items": {
              "$ref": "#/definitions2/address"
            }
          },
          "maxDepth": {
            "description": "Maximum depth of discovery",
            "type": "integer",
            "minimum": 0
          },
          "maxAddresses": {
            "description": "Maximum number of addresses that a discovery script can put on its stack",
            "type": "integer",
            "minimum": 0
          },
          "sharedModules": {
            "description": "An object which keys are contract identifiers and values are names of shared modules",
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^.+$": {
                "type": "string"
              }
            }
          },
          "overrides": {
            "type": "object",
            "description": "Specific configuration for discovered contracts",
            "additionalProperties": false,
            "patternProperties": {
              "^.+$": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ignoreDiscovery": {
                    "type": "boolean"
                  },
                  "proxyType": {
                    "type": "string"
                  },
                  "ignoreInWatchMode": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ignoreMethods": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ignoreRelatives": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                      "^.+$": {
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "description": {
                    "description": "Description for the contract ",
                    "type": "string"
                  },
                  "methods": {
                    "type": "object",
                    "description": "Key-Value store for description <Method>: <Description>",
                    "additionalProperties": false,
                    "patternProperties": {
                      "^.+$": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "names": {
            "type": "object",
            "description": "Human-readable names for discovered contracts",
            "additionalProperties": false,
            "patternProperties": {
              "^0x[a-fA-F\\d]{40}$": {
                "type": "string"
              }
            }
          },
          "descriptions": {
            "type": "object",
            "description": "Description for contracts and their methods",
            "additionalProperties": false,
            "patternProperties": {
              "^.+$": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "description": {
                    "type": "string"
                  },
                  "methods": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                      "^.+$": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
