                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^config$": true,
                "^mutableConfigs$": true,
                "^validQuirks$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "positiveNumber": {
      "type": "number",
      "minimum": 0.0
    },
