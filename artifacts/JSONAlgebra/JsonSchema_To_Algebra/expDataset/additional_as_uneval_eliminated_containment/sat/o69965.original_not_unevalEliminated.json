                "additionalProperties": false,
                "required": [
                  "$ref"
                ],
                "properties": {
                  "$ref": {
                    "title": "Item type URI",
                    "type": "string",
                    "pattern": "^https://ils.rero.ch/api/item_types/.*?$"
                  }
                }
              }
            }
          }
        }
