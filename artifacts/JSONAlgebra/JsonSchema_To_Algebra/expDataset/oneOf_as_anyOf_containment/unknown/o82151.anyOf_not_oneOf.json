      "id": "#job-config-evaluated-v1",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hooks": {
          "$ref": "#/definitions4/hooks"
        },
        "deployers": {
          "patternProperties": {
            ".*": {
