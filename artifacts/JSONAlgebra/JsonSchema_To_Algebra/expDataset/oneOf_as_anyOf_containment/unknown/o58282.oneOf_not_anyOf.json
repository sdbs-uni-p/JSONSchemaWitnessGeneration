            "type": "string",
            "_uniqueItems": true
          },
          "type": "array"
        },
        "name": {
          "default": "All Files",
          "description": "Format name",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Inspector": {
      "description": "Inspector options",
