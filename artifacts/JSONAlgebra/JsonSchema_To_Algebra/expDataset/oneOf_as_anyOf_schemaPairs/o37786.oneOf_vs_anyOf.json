                }
              },
              "additionalProperties": {
                "not": {}
              },
              "minProperties": 1,
              "not": {
                "required": [
                  "ios"
                ]
              }
            }
          ]
        },
        "colorDefinition": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 255
              }
            },
            {
              "type": "string",
              "pattern": "^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]?[0-9a-fA-F]?$"
            },
            {
              "enum": [
                "black",
                "silver",
                "gray",
                "white",
                "maroon",
                "red",
                "purple",
                "fuchsia",
                "green",
                "lime",
                "olive",
                "yellow",
                "navy",
                "blue",
                "teal",
                "aqua",
                "transparent"
              ]
            }
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/definitions2/colorResources"
        }
      ]
    },
