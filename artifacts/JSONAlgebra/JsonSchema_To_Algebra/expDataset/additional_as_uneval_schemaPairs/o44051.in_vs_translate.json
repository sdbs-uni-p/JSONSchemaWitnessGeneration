      "type": "object",
      "additionalProperties": {
        "not": {}
      },
      "properties": {
        "action": {
          "enum": [
            "ingest",
            "publish",
            "ingest+publish"
          ]
        },
        "location": {
          "description": "the location of the article to ingest/publish",
          "type": "string",
          "format": "uri",
          "pattern": "^(https|file)://"
        },
        "id": {
          "description": "article identifier",
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "force": {
          "description": "force ingest/publish action. intended for silent corrections. use with caution.",
          "type": "boolean"
        },
        "token": {
          "description": "data to be returned to the sender once action complete",
          "type": "string"
        }
      },
      "required": [
        "action",
        "location",
        "id",
        "version",
        "token"
      ]
    },
