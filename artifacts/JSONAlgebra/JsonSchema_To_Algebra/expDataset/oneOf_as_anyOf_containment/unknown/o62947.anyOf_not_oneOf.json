          "type": "array",
          "minItems": 1,
          "_uniqueItems": true,
          "items": {
            "enum": [
              "keyboard",
              "joystick",
              "mouse"
            ]
          }
        },
        "developers": {
          "type": "array",
          "_uniqueItems": true,
