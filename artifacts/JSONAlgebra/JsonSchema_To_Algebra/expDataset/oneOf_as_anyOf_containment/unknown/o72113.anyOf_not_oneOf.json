            },
            "aditionalItems": "false",
            "minItems": 1,
            "description": "list of keywords",
            "_uniqueItems": true
          },
          "repository": {
            "type": "string",
            "format": "uri",
            "description": "package git repository uri"
          },
          "bugs": {
            "type": "string",
