[
  {
    "id": 305,
    "schema1": {
      "$id": "influx_config.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "definitions1": {
        "modern_1": {
          "anyOf": [
            {
              "allOf": [
                {
                  "type": "object",
                  "description": "Write datapoints and events to an influxdb database",
                  "required": [
                    "host",
                    "database"
                  ],
                  "properties": {
                    "database": {
                      "type": "string",
                      "description": "Database to connect to on the influxdb server"
                    },
                    "read-extracted-ranges": {
                      "type": "boolean",
                      "description": "Whether to read start/end points on startup, where possible."
                    },
                    "non-finite-replacement": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Replace all instances of NaN or Infinity with this floating point number"
                    },
                    "username": {
                      "type": "string",
                      "description": "Username for the influxdb server"
                    },
                    "host": {
                      "type": "string",
                      "description": "URL of the host influxdb server"
                    },
                    "debug": {
                      "type": "boolean",
                      "description": "Debug mode. If true, data will not be pushed to target"
                    },
                    "read-extracted-event-ranges": {
                      "type": "boolean",
                      "description": "Whether to read start/end points for events on startup, where possible"
                    },
                    "point-chunk-size": {
                      "type": "integer",
                      "description": "Maximum number of points to send in each request to influx",
                      "minimum": 1.0,
                      "default": 100000
                    },
                    "password": {
                      "type": "string",
                      "description": "Password for the influxdb server"
                    }
                  }
                },
                {
                  "patternProperties": {
                    "^debug$": {},
                    "^read-extracted-ranges$": {},
                    "^username$": {},
                    "^read-extracted-event-ranges$": {},
                    "^host$": {},
                    "^password$": {},
                    "^non-finite-replacement$": {},
                    "^point-chunk-size$": {},
                    "^database$": {}
                  },
                  "additionalProperties": {
                    "not": {}
                  }
                }
              ]
            }
          ]
        }
      },
      "$ref": "#/definitions1/modern_1"
    },
    "schema2": {
      "$id": "influx_config.schema.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": {
        "not": {}
      },
      "description": "Write datapoints and events to an influxdb database",
      "required": [
        "host",
        "database"
      ],
      "properties": {
        "host": {
          "type": "string",
          "description": "URL of the host influxdb server"
        },
        "username": {
          "type": "string",
          "description": "Username for the influxdb server"
        },
        "password": {
          "type": "string",
          "description": "Password for the influxdb server"
        },
        "database": {
          "type": "string",
          "description": "Database to connect to on the influxdb server"
        },
        "point-chunk-size": {
          "type": "integer",
          "description": "Maximum number of points to send in each request to influx",
          "minimum": 1,
          "default": 100000
        },
        "debug": {
          "type": "boolean",
          "description": "Debug mode. If true, data will not be pushed to target"
        },
        "read-extracted-ranges": {
          "type": "boolean",
          "description": "Whether to read start/end points on startup, where possible."
        },
        "read-extracted-event-ranges": {
          "type": "boolean",
          "description": "Whether to read start/end points for events on startup, where possible"
        },
        "non-finite-replacement": {
          "type": [
            "number",
            "null"
          ],
          "description": "Replace all instances of NaN or Infinity with this floating point number"
        }
      }
    },
    "tests": {
      "s1SubsetEqOfs2": true,
      "s2SubsetEqOfs1": false
    }
  }
]