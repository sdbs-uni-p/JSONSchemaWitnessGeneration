      "properties": {
        "sent": {
          "type": "integer",
          "minimum": 1
        },
        "failed": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "event": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6
    },
    "error": {
