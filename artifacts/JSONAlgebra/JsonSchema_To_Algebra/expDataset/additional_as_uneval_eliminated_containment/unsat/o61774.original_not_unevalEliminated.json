{
  "allOf": [
    {
      "title": "FxA Push Payload schema",
      "description": "This schema defines what is acceptable to send as a payload data with the Push API from the FxA servers to a device connected to FxA",
      "$schema": "http://json-schema.org/draft-04/schema#",
      "type": "object",
      "anyOf": [
        {
          "$ref": "#/definitions3/deviceConnected"
        },
        {
          "$ref": "#/definitions3/deviceDisconnected"
        },
        {
          "$ref": "#/definitions3/profileUpdated"
        },
        {
          "$ref": "#/definitions3/collectionsChanged"
        },
        {
          "$ref": "#/definitions3/passwordChanged"
        },
        {
          "$ref": "#/definitions3/passwordReset"
        },
        {
          "$ref": "#/definitions3/accountDestroyed"
        },
        {
          "$ref": "#/definitions3/commandReceived"
        }
      ]
    },
    {
      "not": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "FxA Push Payload schema",
        "description": "This schema defines what is acceptable to send as a payload data with the Push API from the FxA servers to a device connected to FxA",
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/definitions4/deviceConnected"
          },
