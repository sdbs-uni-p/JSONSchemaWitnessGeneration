{
  "allOf": [
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "https://raw.githubusercontent.com/mattmccray/syncodemayo/master/config.schema.json",
      "type": "object",
      "required": [
        "local",
        "targets"
      ],
      "properties": {
        "local": {
          "$ref": "#/definitions4/localTarget"
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions4/remoteTarget"
          }
        }
      },
      "additionalProperties": true
    },
    {
      "not": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "id": "https://raw.githubusercontent.com/mattmccray/syncodemayo/master/config.schema.json",
        "type": "object",
        "required": [
          "local",
          "targets"
        ],
        "properties": {
          "local": {
            "$ref": "#/definitions3/localTarget"
          },
          "targets": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions3/remoteTarget"
            }
          }
        },
        "additionalProperties": true
      }
    }
  ],
  "definitions4": {
    "localTarget": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "files": {
          "type": "string",
          "default": "**/**"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "defaultTarget": {
          "type": "string"
        },
        "deleteRemoteFiles": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "remoteTarget": {
      "type": "object",
      "required": [
        "host",
        "path",
        "user"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "pass": {
          "type": "string"
        },
        "port": {
          "type": "number",
          "description": "(Default = 21)",
          "default": 21
        },
        "cache": {
          "type": "string",
          "description": "Name of checksum list file. (Default = '.synco-filelist')",
          "default": ".synco-filelist"
        },
        "prompt": {
          "default": true,
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "type": {
          "type": "string",
          "description": "(reservered for future use)"
        }
      }
    }
  },
  "definitions3": {
