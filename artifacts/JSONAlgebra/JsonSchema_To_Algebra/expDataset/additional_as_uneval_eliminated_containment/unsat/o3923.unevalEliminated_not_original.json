          }
        },
        {
          "type": "object",
          "properties": {
            "testCases": {
              "type": "array",
              "items": {
                "$ref": "#/definitions4/testCase"
              }
            },
            "has": {
              "$ref": "#/definitions4/annotation"
            }
          },
          "required": [
            "testCases"
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "System Test Model",
