        "rooms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/definitions3/occupancyRoom"
          }
        }
      },
      "required": [
        "rooms"
      ]
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}_[A-Z]{2}$"
    },
    "currency": {
      "type": "string",
      "enum": [
        "CHF",
        "EUR",
        "GBP",
        "RUB",
        "USD"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "currency": {
          "$ref": "#/definitions3/currency"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        }
      },
      "required": [
        "currency",
        "amount"
      ]
    },
    "localizedText": {
      "type": "object",
      "properties": {
        "locale": {
          "$ref": "#/definitions3/locale"
        },
        "value": {
          "type": "string"
