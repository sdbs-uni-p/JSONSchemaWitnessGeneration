            "true",
            "false"
          ]
        }
      },
      "required": [
        "courseList",
        "isWorkTerm"
      ],
      "additionalProperties": false
    },
    "orList": {
      "description": "A list of courses where the student can choose any one of them to add to take in the current semester",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/definitions4/regularCourse"
          },
          {
            "$ref": "#/definitions4/electiveCourse"
          }
        ]
      },
      "minItems": 2
    },
    "regularCourse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^\\w{4}\\s{1}\\d{3}$"
        },
        "isElective": {
          "type": "string",
          "pattern": "^false$"
        },
        "electiveType": {
          "type": "string",
          "pattern": "^$"
        }
