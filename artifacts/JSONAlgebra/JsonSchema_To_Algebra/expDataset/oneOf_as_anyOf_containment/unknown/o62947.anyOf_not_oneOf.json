          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "idContentType": {
      "description": "Use https://regex101.com to validate ids",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tape\\d+(\\.side[A-Z](\\.part\\d+){0,1}){0,1}$(\\.alt\\d+){0,1}"
        },
        {
          "type": "string",
          "pattern": "^disk\\d+(\\.alt\\d+){0,1}$"
        },
        {
          "type": "string",
          "pattern": "^rom\\d+(\\.alt\\d+){0,1}$"
        }
      ]
    },
    "extrasType": {
      "description": "Extra content",
