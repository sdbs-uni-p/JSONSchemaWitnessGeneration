              "properties": {
                "inherit": {
                  "enum": [
                    true
                  ]
                }
              },
              "required": [
                "inherit"
              ],
              "additionalProperties": {
                "not": {}
              }
            },
            {
              "description": "Scale Selector",
              "type": "object",
              "patternProperties": {
                "^([0-9]\\.?[0-9]*)x$": {
                  "$ref": "#/definitions2/colorResource"
                }
              },
              "additionalProperties": {
                "not": {}
              },
              "minProperties": 1
            },
            {
              "description": "Locale Selector",
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z][a-zA-Z][a-zA-Z]?(-[\\-a-zA-Z0-9]+)?$": {
