                "inherit": {
                  "title": "Inherit related records",
                  "description": "Records from which many-to-many modules should be linked to resulting records after conversion",
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/definitions4/moduleName"
                      }
                    ]
                  }
                }
