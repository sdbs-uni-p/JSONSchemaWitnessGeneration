                  "properties": {
                    "database": {
                      "type": "string",
                      "description": "Raw database"
                    },
                    "table": {
                      "type": "string",
                      "description": "Raw table"
                    },
                    "upload-interval": {
                      "type": "integer",
                      "description": "Interval in seconds between each upload of state to Raw",
                      "default": 30
                    }
                  }
                },
                {
                  "patternProperties": {
                    "^database$": {},
                    "^table$": {},
                    "^upload-interval$": {}
                  },
                  "additionalProperties": {
                    "not": {}
                  }
                }
              ]
            }
          ]
        },
        "modern_2": {
