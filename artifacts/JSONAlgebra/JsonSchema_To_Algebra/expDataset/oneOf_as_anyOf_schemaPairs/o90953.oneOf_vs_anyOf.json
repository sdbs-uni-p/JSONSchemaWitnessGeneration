                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "note": [
                        "unenforceable in some languages"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "description": "optional, can be anything"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
