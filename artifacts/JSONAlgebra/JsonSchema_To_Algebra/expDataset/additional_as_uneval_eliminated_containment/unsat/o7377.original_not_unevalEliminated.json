          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "description": "The date of import",
          "default": "",
          "type": "string"
        },
        "github": {
          "description": "The github info for this source. If this is imported from github release, it will present.",
          "type": "object",
