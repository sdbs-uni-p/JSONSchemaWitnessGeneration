            "$ref": "#/definitions3/asset"
          },
          "type": "array"
        },
        "date": {
          "$ref": "#/definitions3/date"
        },
        "id": {
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "records": {
