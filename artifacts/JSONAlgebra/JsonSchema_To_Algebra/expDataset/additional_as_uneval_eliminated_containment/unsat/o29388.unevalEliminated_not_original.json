{
  "allOf": [
    {
      "$id": "https://antha.com/actions-schema",
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "JSON Schema for describing actions carried out during liquidhandling",
      "type": "object",
      "required": [
        "version",
        "actions"
      ],
      "properties": {
        "version": {
          "description": "the version of the schema, for validation",
          "const": "1.0"
        },
        "actions": {
          "description": "the actions carried out during the liquidhandling operation",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions4/transferAction"
              },
              {
                "$ref": "#/definitions4/promptAction"
              },
              {
                "$ref": "#/definitions4/waitAction"
              }
            ]
          }
        }
      }
    },
    {
      "not": {
        "$id": "https://antha.com/actions-schema",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "JSON Schema for describing actions carried out during liquidhandling",
        "type": "object",
        "required": [
          "version",
          "actions"
        ],
        "properties": {
          "version": {
            "description": "the version of the schema, for validation",
            "const": "1.0"
          },
          "actions": {
            "description": "the actions carried out during the liquidhandling operation",
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/definitions3/transferAction"
                },
                {
                  "$ref": "#/definitions3/promptAction"
                },
                {
                  "$ref": "#/definitions3/waitAction"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "definitions4": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "summarize the properties of an optional mixing operation",
              "type": "object",
              "required": [
                "cycles",
                "volume",
                "height",
                "flow_rate",
                "liquid_level_follow"
              ],
              "properties": {
                "flow_rate": {
                  "$ref": "#/definitions4/measurement"
                },
                "height": {
                  "$ref": "#/definitions4/height"
                },
                "liquid_level_follow": {
                  "description": "if true, follow the liquid level during the operation",
                  "type": "boolean"
                },
                "cycles": {
                  "description": "The number of mix cycles that were carried out",
                  "type": "number",
                  "multipleOf": 1.0,
                  "minimum": 0.0
                },
                "volume": {
                  "$ref": "#/definitions4/measurement"
                }
              }
            },
            {
              "patternProperties": {
                "^flow_rate$": true,
                "^cycles$": true,
                "^height$": true,
                "^liquid_level_follow$": true,
                "^volume$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Describe a single channel transfer",
              "type": "object",
              "required": [
                "from",
                "to",
                "volume",
                "wasted",
                "policy",
                "asp",
                "dsp",
                "head"
              ],
              "properties": {
                "dsp": {
                  "description": "Parameters related to the way in which dispensing was performed",
                  "allOf": [
                    {
                      "$ref": "#/definitions4/pipettingOptions"
                    },
                    {
                      "type": "object",
                      "required": [
                        "touchoff"
                      ],
                      "parameters": {
                        "blowout": {
                          "description": "parameters related to a blowout operation",
                          "type": "object",
                          "required": [
                            "volume",
                            "height",
                            "flow_rate"
                          ],
                          "properties": {
                            "volume": {
                              "description": "the volume used for a blowout, if performed",
                              "$ref": "#/definitions4/measurement"
                            },
                            "height": {
                              "description": "the height from which to perform a blowout",
                              "$ref": "#/definitions4/height"
                            },
                            "flow_rate": {
                              "description": "the flow rate for the blowout operation",
                              "$ref": "#/definitions4/measurement"
                            }
                          }
                        },
                        "touchoff": {
                          "description": "whether or not a touchoff is performed",
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                },
                "to": {
                  "description": "the destination(s) of the transfer, multiple implies multi-dispense",
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions4/contentUpdate"
                  },
                  "minItems": 1
                },
                "asp": {
                  "description": "Parameters related to the way in which aspiration was performed",
                  "$ref": "#/definitions4/pipettingOptions"
                },
                "head": {
                  "description": "the head to load tips to or unload tips from",
                  "type": "number",
                  "multipleOf": 1.0,
                  "minimum": 0.0
                },
                "wasted": {
                  "description": "the volume of liquid wasted in this operation",
                  "$ref": "#/definitions4/measurement"
                },
                "from": {
                  "description": "the source location of the transfer",
                  "$ref": "#/definitions4/contentUpdate"
                },
                "policy": {
                  "description": "the name of the liquid type for this transfer",
                  "type": "string"
                },
                "volume": {
                  "description": "the volume of liquid transferred in this operation",
                  "$ref": "#/definitions4/measurement"
                }
              }
            },
            {
              "patternProperties": {
                "^policy$": true,
                "^to$": true,
                "^wasted$": true,
                "^volume$": true,
                "^dsp$": true,
                "^from$": true,
                "^asp$": true,
                "^head$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "transferAction": {
      "$ref": "#/definitions4/modern_4"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Describe a liquid in a plate well",
              "type": "object",
              "required": [
                "name",
                "total_volume"
              ],
              "properties": {
                "name": {
                  "description": "The display name of the liquid",
                  "type": "string"
                },
                "total_volume": {
                  "description": "The total volume present of the liquid",
                  "$ref": "#/definitions4/measurement"
                },
                "components": {
                  "$ref": "#/definitions4/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^total_volume$": true,
                "^components$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "wellLocation": {
      "$ref": "#/definitions4/modern_5"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "describes an on-screen prompt which waits for user input",
              "type": "object",
              "required": [
                "kind",
                "message",
                "time_estimate",
                "cumulative_time_estimate"
              ],
              "properties": {
                "kind": {
                  "const": "prompt"
                },
                "message": {
                  "description": "the message that is shown to the user",
                  "type": "string"
                },
                "time_estimate": {
                  "description": "estimate of time taken for this instruction, in seconds",
                  "type": "number",
                  "minimum": 0.0
                },
                "cumulative_time_estimate": {
                  "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            {
              "patternProperties": {
                "^kind$": true,
                "^message$": true,
                "^time_estimate$": true,
                "^cumulative_time_estimate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The sub-components which make up this liquid",
              "type": "array",
              "items": {
                "$ref": "#/definitions4/modern_3"
              }
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "pipettingOptions": {
      "description": "describes options about how pipetting was carried out",
      "type": "object",
      "required": [
        "height",
        "flow_rate",
        "liquid_level_follow"
      ],
      "properties": {
        "height": {
          "$ref": "#/definitions4/height"
        },
        "flow_rate": {
          "$ref": "#/definitions4/measurement"
        },
        "liquid_level_follow": {
          "description": "if true, follow the liquid level during the operation",
          "type": "boolean"
        },
        "mixing": {
          "$ref": "#/definitions4/modern_6"
        }
      }
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "represents a list of transfers that are carried out simultaneously by a set of channels",
              "type": "object",
              "required": [
                "channels",
                "kind",
                "time_estimate",
                "cumulative_time_estimate"
              ],
              "properties": {
                "kind": {
                  "const": "parallel_transfer"
                },
                "channels": {
                  "$ref": "#/definitions4/modern_13"
                },
                "time_estimate": {
                  "description": "estimate of time taken for this instruction, in seconds",
                  "type": "number",
                  "minimum": 0.0
                },
                "cumulative_time_estimate": {
                  "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            {
              "patternProperties": {
                "^kind$": true,
                "^channels$": true,
                "^time_estimate$": true,
                "^cumulative_time_estimate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "promptAction": {
      "$ref": "#/definitions4/modern_7"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "the position(s) to load tips from or drop tips to for each channel.",
              "type": "object",
              "patternProperties": {
                "^[0-9]+": {
                  "$ref": "#/definitions4/wellLocation"
                }
              }
            },
            {
              "patternProperties": {
                "^[0-9]+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The height of the end of the tip relative to something",
              "type": "object",
              "required": [
                "reference",
                "value",
                "unit"
              ],
              "properties": {
                "reference": {
                  "description": "The datum for the height",
                  "enum": [
                    "well_bottom",
                    "well_top",
                    "liquid_level"
                  ]
                },
                "value": {
                  "description": "The value of the height",
                  "type": "number"
                },
                "unit": {
                  "description": "The units in which the height is expressed",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^reference$": true,
                "^value$": true,
                "^unit$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "describes an on-screen prompt which waits for user input",
              "type": "object",
              "required": [
                "kind",
                "duration_seconds",
                "time_estimate",
                "cumulative_time_estimate"
              ],
              "properties": {
                "time_estimate": {
                  "description": "estimate of time taken for this instruction, in seconds",
                  "type": "number",
                  "minimum": 0.0
                },
                "duration_seconds": {
                  "description": "how long to wait for, in seconds",
                  "type": "number",
                  "minimum": 0.0
                },
                "message": {
                  "description": "the (optional) message that is shown to the user while waiting",
                  "type": "string"
                },
                "kind": {
                  "const": "wait"
                },
                "cumulative_time_estimate": {
                  "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            {
              "patternProperties": {
                "^kind$": true,
                "^duration_seconds$": true,
                "^time_estimate$": true,
                "^cumulative_time_estimate$": true,
                "^message$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "singleTransfer": {
      "$ref": "#/definitions4/modern_10"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "describe an entire transfer action, which is a list of load, unload & parallelTransfer operations that are logically grouped",
              "type": "object",
              "required": [
                "kind",
                "children",
                "time_estimate",
                "cumulative_time_estimate"
              ],
              "properties": {
                "kind": {
                  "const": "transfer"
                },
                "children": {
                  "description": "the child actions carried out during this transfer",
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/definitions4/tipAction"
                      },
                      {
                        "$ref": "#/definitions4/parallelTransfer"
                      }
                    ]
                  },
                  "minItems": 1
                },
                "time_estimate": {
                  "description": "estimate of time taken for this instruction, in seconds",
                  "type": "number",
                  "minimum": 0.0
                },
                "cumulative_time_estimate": {
                  "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            {
              "patternProperties": {
                "^kind$": true,
                "^children$": true,
                "^time_estimate$": true,
                "^cumulative_time_estimate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
