      ],
      "properties": {
        "value": {
          "description": "The value of the measurement",
          "type": "number"
        },
        "unit": {
          "description": "The units in which the measurement is expressed",
          "type": "string"
        }
      }
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "updates the contents of a well",
              "type": "object",
