          "type": "string",
          "enum": [
            "cookie",
            "header",
            "path",
            "query"
          ]
        },
        "style": {
          "type": "string",
          "enum": [
            "deepObject",
            "form",
            "label",
            "matrix",
            "pipeDelimited",
            "simple",
            "spaceDelimited"
          ]
        },
        "explode": {
          "type": "boolean"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "data": {
