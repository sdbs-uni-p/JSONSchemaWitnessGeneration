          "title": "height",
          "default": 480,
          "examples": [
            480
          ]
        },
        "x": {
          "type": "integer",
          "title": "left",
          "default": 0,
          "examples": [
            640
          ]
        },
        "y": {
          "type": "integer",
          "title": "top",
          "default": 0,
          "examples": [
            480
          ]
        }
      },
      "additionalProperties": false
    },
    "sprite": {
      "$id": "#/definitions3/sprite",
      "type": "object",
      "title": "Sprite Schema",
      "properties": {
        "rotated": {
          "type": "boolean"
        },
        "frame": {
          "$ref": "#/definitions3/sizeAndPosition"
        },
        "trimmed": {
          "type": "boolean"
        },
        "sourceSize": {
          "$ref": "#/definitions3/size"
        },
        "spriteSourceSize": {
          "$ref": "#/definitions3/sizeAndPosition"
        }
      },
      "additionalProperties": false
    }
  },
