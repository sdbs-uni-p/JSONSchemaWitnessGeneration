              "required": [
                "condition",
                "modules",
                "post"
              ]
            },
            {
              "patternProperties": {
                "^condition$": true,
                "^modules$": true,
                "^post$": true,
                "^inherit$": true
              },
              "additionalProperties": false
            }
          ]
        }
