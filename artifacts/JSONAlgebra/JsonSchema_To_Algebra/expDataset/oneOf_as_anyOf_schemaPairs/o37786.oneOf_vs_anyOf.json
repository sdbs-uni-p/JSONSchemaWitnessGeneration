            {
              "$ref": "#/definitions2/colorDefinition"
            },
            {
              "$ref": "#/definitions2/colorSelector"
            }
          ]
        },
        "colorSelector": {
          "oneOf": [
            {
              "description": "Platform Selector",
              "type": "object",
              "properties": {
                "ios": {
                  "$ref": "#/definitions2/colorResource"
                },
                "android": {
                  "$ref": "#/definitions2/colorResource"
                }
              },
              "required": [
                "ios",
                "android"
              ],
              "additionalProperties": {
                "not": {}
              }
            },
            {
              "description": "Resource Reference",
              "type": "object",
              "required": [
                "ref"
              ],
              "properties": {
                "ref": {
                  "type": "string"
                }
              },
              "additionalProperties": {
                "not": {}
              }
            },
            {
              "description": "Inherit Marker",
