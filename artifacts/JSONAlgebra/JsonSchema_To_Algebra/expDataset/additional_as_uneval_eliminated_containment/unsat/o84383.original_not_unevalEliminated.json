              "description": "Limit resources used by this container.",
              "type": "object",
              "properties": {
                "maxCpu": {
                  "description": "The total number of cores or percent this container can utilise.",
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    },
                    {
                      "type": "integer",
                      "minimum": 1.0
                    },
                    {
                      "$ref": "#/definitions4/resourceUnlimited"
                    }
                  ],
                  "optional": true,
                  "default": "unlimited"
                },
                "maxHdd": {
                  "description": "The total amount of disk space, in Gigabytes (G) or Megabytes (M), this container.",
                  "oneOf": [
                    {
                      "$ref": "#/definitions4/typeSizeMegabyte"
                    },
                    {
                      "$ref": "#/definitions4/typeSizeGigabyte"
