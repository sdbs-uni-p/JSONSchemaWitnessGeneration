            "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 2
            }
          },
          "additionalProperties": {
            "not": {}
          },
          "pbj": {
            "type": "trinary",
            "rule": "map"
          }
        }
      },
      "required": [
        "_schema"
      ],
      "additionalProperties": {
        "not": {}
      }
    },
