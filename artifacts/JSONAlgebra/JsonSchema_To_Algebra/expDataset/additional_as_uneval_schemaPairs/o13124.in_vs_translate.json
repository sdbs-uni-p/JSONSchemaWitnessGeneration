        },
        "complex_matrix": {
          "description": "JSON representation of a complex matrix",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions2/complex_array"
          }
        },
        "memory": {
          "type": "array",
          "minItems": 1,
          "description": "Output of the memory"
        },
        "resultobj": {
          "type": "object",
          "required": [
            "success",
            "shots",
            "data"
          ],
          "properties": {
            "shots": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
