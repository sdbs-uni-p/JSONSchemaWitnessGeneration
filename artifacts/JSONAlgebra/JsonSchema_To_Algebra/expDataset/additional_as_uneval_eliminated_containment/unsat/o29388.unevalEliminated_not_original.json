                    "volume",
                    "height",
                    "flow_rate"
                  ],
                  "properties": {
                    "volume": {
                      "description": "the volume used for a blowout, if performed",
                      "$ref": "#/definitions3/measurement"
                    },
                    "height": {
                      "description": "the height from which to perform a blowout",
                      "$ref": "#/definitions3/height"
                    },
                    "flow_rate": {
                      "description": "the flow rate for the blowout operation",
                      "$ref": "#/definitions3/measurement"
                    }
                  }
                },
                "touchoff": {
                  "description": "whether or not a touchoff is performed",
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "head": {
          "description": "the head to load tips to or unload tips from",
          "type": "number",
          "multipleOf": 1.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "pipettingOptions": {
      "description": "describes options about how pipetting was carried out",
      "type": "object",
      "required": [
        "height",
        "flow_rate",
        "liquid_level_follow"
      ],
      "properties": {
        "height": {
          "$ref": "#/definitions3/height"
        },
        "flow_rate": {
          "$ref": "#/definitions3/measurement"
        },
        "liquid_level_follow": {
          "description": "if true, follow the liquid level during the operation",
          "type": "boolean"
        },
        "mixing": {
          "description": "summarize the properties of an optional mixing operation",
          "type": "object",
          "required": [
            "cycles",
            "volume",
            "height",
            "flow_rate",
            "liquid_level_follow"
          ],
          "properties": {
            "cycles": {
              "description": "The number of mix cycles that were carried out",
              "type": "number",
              "multipleOf": 1.0,
              "minimum": 0.0
            },
            "volume": {
              "$ref": "#/definitions3/measurement"
            },
            "height": {
              "$ref": "#/definitions3/height"
            },
            "flow_rate": {
              "$ref": "#/definitions3/measurement"
            },
            "liquid_level_follow": {
              "description": "if true, follow the liquid level during the operation",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "parallelTransfer": {
      "description": "represents a list of transfers that are carried out simultaneously by a set of channels",
      "type": "object",
      "required": [
        "channels",
        "kind",
        "time_estimate",
        "cumulative_time_estimate"
      ],
      "properties": {
        "kind": {
          "const": "parallel_transfer"
        },
        "channels": {
          "description": "the array of channels, indexed by channel number",
          "type": "object",
          "patternProperties": {
            "^[0-9]+": {
              "$ref": "#/definitions3/singleTransfer"
            }
          },
          "additionalProperties": false
        },
        "time_estimate": {
          "description": "estimate of time taken for this instruction, in seconds",
          "type": "number",
          "minimum": 0.0
        },
        "cumulative_time_estimate": {
          "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
          "type": "number",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "tipAction": {
      "description": "describe the action of loading or unloading tips",
      "type": "object",
      "required": [
        "channels",
        "kind",
        "head",
        "time_estimate",
        "cumulative_time_estimate"
      ],
      "properties": {
        "kind": {
          "enum": [
            "load",
            "unload"
          ]
        },
        "head": {
          "description": "the head to load tips to or unload tips from",
          "type": "number",
          "multipleOf": 1.0,
          "minimum": 0.0
        },
        "channels": {
          "description": "the position(s) to load tips from or drop tips to for each channel.",
          "type": "object",
          "patternProperties": {
            "^[0-9]+": {
              "$ref": "#/definitions3/wellLocation"
            }
          },
          "additionalProperties": false
        },
        "time_estimate": {
          "description": "estimate of time taken for this instruction, in seconds",
          "type": "number",
          "minimum": 0.0
        },
        "cumulative_time_estimate": {
          "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "transferAction": {
      "description": "describe an entire transfer action, which is a list of load, unload & parallelTransfer operations that are logically grouped",
      "type": "object",
      "required": [
        "kind",
        "children",
        "time_estimate",
        "cumulative_time_estimate"
      ],
      "properties": {
        "kind": {
          "const": "transfer"
        },
        "children": {
          "description": "the child actions carried out during this transfer",
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions3/tipAction"
              },
              {
                "$ref": "#/definitions3/parallelTransfer"
              }
            ]
          },
          "minItems": 1
        },
        "time_estimate": {
          "description": "estimate of time taken for this instruction, in seconds",
          "type": "number",
          "minimum": 0.0
        },
        "cumulative_time_estimate": {
          "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
          "type": "number",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "promptAction": {
      "description": "describes an on-screen prompt which waits for user input",
      "type": "object",
      "required": [
        "kind",
        "message",
        "time_estimate",
        "cumulative_time_estimate"
      ],
      "properties": {
        "kind": {
          "const": "prompt"
        },
        "message": {
          "description": "the message that is shown to the user",
          "type": "string"
        },
        "time_estimate": {
          "description": "estimate of time taken for this instruction, in seconds",
          "type": "number",
          "minimum": 0.0
        },
        "cumulative_time_estimate": {
          "description": "estimate of total time taken for the run so far after this instruction has completed, in seconds",
          "type": "number",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "waitAction": {
      "description": "describes an on-screen prompt which waits for user input",
      "type": "object",
      "required": [
        "kind",
        "duration_seconds",
        "time_estimate",
        "cumulative_time_estimate"
      ],
      "properties": {
