          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "meta": {
              "$ref": "#/definitions2/meta"
            }
          },
          "additionalProperties": {
            "not": {}
          }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "first": {
              "description": "The first page of data",
              "oneOf": [
                {
                  "type": "string",
                  "format": "uri-reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last": {
              "description": "The last page of data",
