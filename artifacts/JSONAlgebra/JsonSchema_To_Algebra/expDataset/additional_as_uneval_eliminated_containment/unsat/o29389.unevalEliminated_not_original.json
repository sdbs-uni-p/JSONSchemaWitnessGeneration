              "description": "volume which cannot be removed from the wells of a plate",
              "$ref": "#/definitions4/measurement"
            },
            "contents": {
              "$ref": "#/definitions4/modern_5"
            }
          },
          "required": [
            "kind",
            "residual_volume"
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
