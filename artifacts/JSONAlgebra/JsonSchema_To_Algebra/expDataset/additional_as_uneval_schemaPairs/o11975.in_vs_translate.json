                "description": "Hull value for the ship",
                "type": "integer"
              },
              "multisection_id": {
                "type": "integer"
              },
              "name": {
                "pattern": "^[0-9a-z]+$",
                "type": "string"
              },
              "points": {
                "description": "The total points spent creating this squadron.",
                "type": "integer"
              },
              "shields": {
                "description": "Shield value for the ship",
                "type": "integer"
              },
