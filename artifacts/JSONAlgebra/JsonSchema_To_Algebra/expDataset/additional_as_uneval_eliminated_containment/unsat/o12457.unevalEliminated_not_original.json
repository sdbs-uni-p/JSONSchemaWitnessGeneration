                },
                "ulPerMm": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions4/liquidHandlingSpecs"
                  }
                },
                "top": {
                  "$ref": "#/definitions4/editConfigurations"
                }
              }
            },
            {
              "patternProperties": {
                "^bottom$": true,
                "^pickUpCurrent$": true,
                "^backCompatNames$": true,
                "^quirks$": true,
                "^pickUpDistance$": true,
                "^plungerCurrent$": true,
                "^name$": true,
                "^dropTipSpeed$": true,
                "^tipLength$": true,
                "^pickUpPresses$": true,
                "^tipOverlap$": true,
                "^pickUpSpeed$": true,
                "^dropTip$": true,
                "^dropTipCurrent$": true,
                "^blowout$": true,
                "^pickUpIncrement$": true,
                "^returnTipHeight$": true,
                "^top$": true,
                "^modelOffset$": true,
                "^ulPerMm$": true,
                "^idleCurrent$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "idleCurrentRange": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1.0
    },
    "linearEquations": {
      "description": "Array containing any number of 3-arrays. Each inner 3-array describes a line segment: [boundary, slope, intercept]. So [1, 2, 3] would mean 'where (next_boundary > x >= 1), y = 2x + 3'",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      }
    },
    "returnTipHeightRange": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 1.25
    },
    "liquidHandlingSpecs": {
      "$ref": "#/definitions4/modern_1"
    },
    "modern_2": {
      "anyOf": [
