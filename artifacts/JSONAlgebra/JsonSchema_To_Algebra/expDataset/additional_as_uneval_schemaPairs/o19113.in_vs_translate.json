      "type": "object",
      "additionalProperties": {
        "not": {}
      },
      "properties": {
        "version": {
          "type": "integer",
          "description": "Version number."
        },
        "component_types": {
          "description": "List of component types.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "not": {}
            },
            "properties": {
              "name": {
                "type": "string",
