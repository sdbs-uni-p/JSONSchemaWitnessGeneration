        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 255
        },
        "roles": {
          "type": "array",
          "items": [
            {
              "type": "string",
              "pattern": "^[\\w\\/\\.:-]+$"
            }
          ],
          "_uniqueItems": true,
          "additionalProperties": {
            "not": {}
          },
          "description": "The roles determine what permissions this app will have when using the system. The role itself is a node which has a set of \"allow\" and \"deny\" rules."
        },
        "sendgrid_api_key": {
          "type": "string",
          "minLength": 0,
          "maxLength": 65535,
          "description": "This field contains an access token (used as bearer token) and in some cases SMTP username and password. It should be encrypted. @link https://sendgrid.com/docs/ui/account-and-settings/api-keys/"
        },
        "sendgrid_lists": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "additionalProperties": {
            "not": {}
          },
          "description": "Keys are list slugs, e.g. \"newsletter-subscribers\" and values are sendgrid list ids. @link https://sendgrid.api-docs.io/v3.0/contacts-api-lists/create-a-list"
        },
        "sendgrid_senders": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "additionalProperties": {
            "not": {}
          },
          "description": "Keys are emails and values are sendgrid sender ids. @link https://sendgrid.api-docs.io/v3.0/sender-identities-api/create-a-sender-identity"
        },
        "sendgrid_suppression_group_id": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 4294967295,
          "description": "The default sendgrid suppression group id."
        }
      },
      "required": [
        "_id"
      ],
      "additionalProperties": {}
