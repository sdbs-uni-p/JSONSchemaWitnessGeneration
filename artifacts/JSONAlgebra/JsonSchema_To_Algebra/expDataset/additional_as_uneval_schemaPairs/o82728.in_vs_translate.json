          "patternProperties": {
            "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            }
          },
          "additionalProperties": {
            "not": {}
          },
          "pbj": {
            "type": "string",
            "rule": "map"
          }
        },
        "trinaries": {
