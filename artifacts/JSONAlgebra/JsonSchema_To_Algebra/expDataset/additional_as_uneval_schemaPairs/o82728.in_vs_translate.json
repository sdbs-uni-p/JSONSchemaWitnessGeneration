          "pbj": {
            "type": "string",
            "rule": "single"
          }
        },
        "promotion_slot": {
          "type": "string",
          "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
          "minLength": 0,
          "maxLength": 255,
