          "pattern": "^[0-9a-f]{64}$"
        },
        "os": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "engine": {
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "failureReason": {
          "$ref": "#/definitions3/error"
        },
        "name": {
          "enum": [
            "addons",
            "bookmarks",
            "clients",
            "forms",
            "history",
            "passwords",
            "prefs",
            "tabs"
          ]
        },
        "took": {
          "type": "integer",
          "minimum": 1
