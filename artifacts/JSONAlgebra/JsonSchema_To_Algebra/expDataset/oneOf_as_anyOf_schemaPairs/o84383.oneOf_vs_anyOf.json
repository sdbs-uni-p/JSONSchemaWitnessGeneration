            "persistentStorage": {
              "type": "object",
              "optional": true,
              "description": "Create a persistent block of storage for this container",
              "additionalProperties": {
                "not": {}
              },
              "properties": {
                "identifier": {
                  "description": "A unique name to identify this block of persistent storage.",
                  "type": "string",
                  "pattern": "^[-_a-zA-Z0-9]+$"
                },
                "mountPoint": {
                  "description": "The path within the container that the persistent storage will be mounted.",
                  "$ref": "#/definitions2/stringPath"
                }
              },
              "required": [
                "identifier",
                "mountPoint"
              ]
            },
            "resourceLimits": {
              "description": "Limit resources used by this container.",
              "type": "object",
              "additionalProperties": {
                "not": {}
              },
              "properties": {
                "maxCpu": {
                  "description": "The total number of cores or percent this container can utilise.",
                  "optional": true,
                  "default": "unlimited",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+%$"
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "$ref": "#/definitions2/resourceUnlimited"
                    }
                  ]
                },
                "maxHdd": {
                  "description": "The total amount of disk space, in Gigabytes (G) or Megabytes (M), this container.",
                  "optional": true,
                  "default": "unlimited",
                  "anyOf": [
                    {
                      "$ref": "#/definitions2/typeSizeMegabyte"
                    },
                    {
                      "$ref": "#/definitions2/typeSizeGigabyte"
                    },
                    {
                      "$ref": "#/definitions2/resourceUnlimited"
                    }
                  ]
                },
                "maxRam": {
                  "description": "The total amount of RAM, in Gigabytes (G) or Megabytes (M), this container can utilise.",
                  "optional": true,
                  "default": "unlimited",
                  "anyOf": [
                    {
                      "$ref": "#/definitions2/typeSizeMegabyte"
                    },
                    {
                      "$ref": "#/definitions2/typeSizeGigabyte"
                    },
                    {
                      "$ref": "#/definitions2/resourceUnlimited"
                    }
                  ]
                }
              }
            },
            "proxy": {
              "type": "object",
              "additionalProperties": {
                "not": {}
              },
              "properties": {
                "layer4Proxy": {
                  "description": "Layer4 proxy allows the container to use the Hosts external IP and forward traffic to your container on specific ports.",
                  "type": "boolean",
                  "default": false
                },
                "layer7Proxy": {
                  "description": "Group of properties for URL(s) the container services and responds to.",
                  "optional": true,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "not": {}
                    },
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "cert": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "enableWebsocket": {
                        "optional": true,
                        "type": "boolean",
                        "default": false
                      },
                      "errorResponse": {
                        "type": "boolean",
                        "default": true
                      },
                      "maxFileSize": {
                        "type": "string",
                        "optional": true,
                        "pattern": "^[0-9]+(m|g)$",
                        "default": "1m"
                      },
                      "redirects": {
                        "type": "array",
                        "optional": true,
                        "items": {
                          "type": "object",
                          "anyOf": [
                            {
                              "$ref": "#/definitions2/httpRedirect"
                            },
                            {
                              "$ref": "#/definitions2/httpsRedirect"
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "url",
                      "cert"
                    ]
                  }
                }
              },
              "required": [
                "layer4Proxy"
              ]
            },
