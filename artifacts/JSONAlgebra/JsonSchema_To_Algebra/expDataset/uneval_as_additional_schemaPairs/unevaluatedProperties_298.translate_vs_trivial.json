[
  {
    "id": 117,
    "schema1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "std:sha256",
      "definitions1": {
        "modern_1": {
          "anyOf": [
            {
              "allOf": [
                {
                  "title": "Standart SHA 256",
                  "description": "This extension models a sha256 hash of a file content.",
                  "$comment": "The Interpreter must be able to compare the hash with hashes of files and to delete that files.",
                  "type": "object",
                  "required": [
                    "hash"
                  ],
                  "properties": {
                    "hash": {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$",
                      "examples": [
                        "8d5d33cf0917941602eecf16b34a0ab07d1ebf0c95d284557ebde921b46d5a1b"
                      ]
                    }
                  }
                },
                {
                  "patternProperties": {
                    "^hash$": {}
                  },
                  "additionalProperties": {
                    "not": {}
                  }
                }
              ]
            }
          ]
        }
      },
      "$ref": "#/definitions1/modern_1"
    },
    "schema2": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "std:sha256",
      "title": "Standart SHA 256",
      "description": "This extension models a sha256 hash of a file content.",
      "$comment": "The Interpreter must be able to compare the hash with hashes of files and to delete that files.",
      "type": "object",
      "additionalProperties": {
        "not": {}
      },
      "required": [
        "hash"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "examples": [
            "8d5d33cf0917941602eecf16b34a0ab07d1ebf0c95d284557ebde921b46d5a1b"
          ]
        }
      }
    },
    "tests": {
      "s1SubsetEqOfs2": true,
      "s2SubsetEqOfs1": false
    }
  }
