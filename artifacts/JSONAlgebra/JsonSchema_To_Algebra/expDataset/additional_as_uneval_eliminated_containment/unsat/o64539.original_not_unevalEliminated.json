              "organisation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "affiliation": {
                "description": "Affilated organisations ",
                "type": "array",
                "_uniqueItems": true,
                "additionalItems": false,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
