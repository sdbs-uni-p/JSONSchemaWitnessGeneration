    "resourceUnlimited": {
      "type": "string",
      "enum": [
        "unlimited"
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "$ref": "#/definitions4/uriProtocolHttp"
                },
                "cert": {
                  "type": "null",
                  "enum": [
                    null
                  ]
                }
              },
              "required": [
                "url",
                "cert"
              ]
            },
            {
              "patternProperties": {
                "^url$": true,
                "^cert$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "uriProtocolHttp": {
      "type": "string",
      "pattern": "^http:\\/\\/"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "exec"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "operationExec": {
      "$ref": "#/definitions4/modern_6"
    },
    "validIpv4WithCidr": {
      "type": "string",
