                "height",
                "length",
                "weight"
              ],
              "description": "defines package dimensions"
            },
            {
              "patternProperties": {
                "^width$": true,
                "^height$": true,
                "^length$": true,
                "^weight$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
