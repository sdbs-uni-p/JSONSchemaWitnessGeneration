          "type": "string",
          "description": "The id of the layer as listed on the operational layer."
        },
        "subLayerIds": {
          "type": "array",
          "description": "List of visible sublayer ids, as listed on the service of the layer.",
          "items": {
            "type": "integer"
          }
        }
      },
