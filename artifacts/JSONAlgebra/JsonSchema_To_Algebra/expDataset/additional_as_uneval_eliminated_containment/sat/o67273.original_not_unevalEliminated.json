            "type": "object",
            "additionalProperties": true,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "The repository type."
              }
            }
          }
        },
        "projects": {
          "type": "array",
          "description": "A set with projects that shouls be created in the IDE.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "configurations": {
                "type": "array",
