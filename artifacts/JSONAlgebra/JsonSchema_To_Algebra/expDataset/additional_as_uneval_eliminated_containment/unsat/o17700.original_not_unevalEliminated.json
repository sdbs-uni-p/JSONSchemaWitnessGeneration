          "additionalProperties": false,
          "properties": {
            "sync": {
              "type": "string"
            },
            "service": {
              "type": "string"
            }
          }
        },
        "why": {
          "enum": [
            "startup",
            "schedule",
            "score",
            "user",
            "tabs"
          ]
        },
        "took": {
          "type": "integer",
          "minimum": -1
        },
        "failureReason": {
          "$ref": "#/definitions3/error"
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions3/engine"
          }
        }
      }
    },
    "device": {
      "required": [
        "os",
        "id",
        "version"
      ],
      "additionalProperties": false,
      "type": "object",
