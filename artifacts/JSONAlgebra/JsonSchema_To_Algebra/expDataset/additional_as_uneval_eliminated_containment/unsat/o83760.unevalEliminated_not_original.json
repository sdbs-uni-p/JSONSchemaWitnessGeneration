              "format": "host-name"
            },
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ],
          "type": "string"
        },
        "type": {
          "enum": [
            "nfs"
          ]
        }
      },
      "required": [
        "type",
        "server",
        "remotePath"
      ]
    },
    "tmpfs": {
      "additionalProperties": false,
      "properties": {
        "sizeInMB": {
          "maximum": 512,
          "minimum": 16,
          "type": "integer"
        },
        "type": {
          "enum": [
