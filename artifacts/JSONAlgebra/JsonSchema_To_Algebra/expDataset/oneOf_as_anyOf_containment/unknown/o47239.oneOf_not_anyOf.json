  "definitions3": {
    "destinationCity": {
      "type": "object",
      "properties": {
        "cityId": {
          "type": "string"
        }
      },
      "required": [
        "cityId"
      ]
    },
    "destinationRegion": {
      "type": "object",
      "properties": {
        "regionId": {
          "type": "string"
        }
      },
      "required": [
        "regionId"
      ]
