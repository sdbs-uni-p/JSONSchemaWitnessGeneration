              "properties": {
                "counts": {
                  "type": "object",
                  "description": "Histogram of the memory over the indicated shots",
                  "patternProperties": {
                    "^0x([0-9A-Fa-f])+$": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "unevaluatedProperties": false
                },
                "snapshots": {
                  "description": "collection of all snapshots of simulator state",
                  "type": "object"
                },
                "memory": {
                  "$ref": "#/definitions2/memory"
                },
                "statevector": {
                  "$ref": "#/definitions2/complex_array"
                },
                "unitary": {
                  "$ref": "#/definitions2/complex_matrix"
                }
              }
            }
          }
        }
      },
      "id": "http://www.qiskit.org/schemas/result_schema.json",
      "title": "qobj results",
      "description": "The results of executing a qobj",
      "version": "1.0.0",
      "type": "object",
      "required": [
