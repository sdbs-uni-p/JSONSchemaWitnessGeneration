          "description": "Sometimes a human readable comment is helpful and can be added here"
        },
        "conditions": {
          "type": [
            "object",
            "boolean"
          ],
          "$comment": "see here for a non official JSON Logic schema: https://github.com/axa-ch/json-logic-js/tree/master/schemas"
        }
      }
    }
