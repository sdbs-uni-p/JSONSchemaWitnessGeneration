{
  "allOf": [
    {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "title": "ledgerVersion",
      "description": "A ledger version number",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "enum": [
            "validated",
            "closed",
            "current"
          ]
        }
      ]
    },
    {
      "not": {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "title": "ledgerVersion",
        "description": "A ledger version number",
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "string",
            "enum": [
              "validated",
              "closed",
              "current"
            ]
          }
        ]
      }
    }
  ]
}