[
  {
    "id": 78,
    "schema1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "std:uuidv4",
      "definitions1": {
        "modern_1": {
          "anyOf": [
            {
              "allOf": [
                {
                  "title": "Standart UUIDv4",
                  "description": "This extension can be used to address data based on a UUID.",
                  "$comment": "In data management systems, universal unique IDs are often used to identify data sets. If this is done with UUIDv4, this extension can be used to address data.",
                  "type": "object",
                  "required": [
                    "uuid"
                  ],
                  "properties": {
                    "uuid": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$",
                      "examples": [
                        "3fbf3f3f-3a2c-4808-81ee-6741aa9dddfa"
                      ]
                    }
                  }
                },
                {
                  "patternProperties": {
                    "^uuid$": {}
                  },
                  "additionalProperties": {
                    "not": {}
                  }
                }
              ]
            }
          ]
        }
      },
      "$ref": "#/definitions1/modern_1"
    },
    "schema2": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "std:uuidv4",
      "title": "Standart UUIDv4",
      "description": "This extension can be used to address data based on a UUID.",
      "$comment": "In data management systems, universal unique IDs are often used to identify data sets. If this is done with UUIDv4, this extension can be used to address data.",
      "type": "object",
      "additionalProperties": {
        "not": {}
      },
      "required": [
        "uuid"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[089ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "examples": [
            "3fbf3f3f-3a2c-4808-81ee-6741aa9dddfa"
          ]
        }
      }
    },
    "tests": {
      "s1SubsetEqOfs2": true,
      "s2SubsetEqOfs1": false
    }
  }
]