              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "homepage": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "roles": {
                "type": "array",
