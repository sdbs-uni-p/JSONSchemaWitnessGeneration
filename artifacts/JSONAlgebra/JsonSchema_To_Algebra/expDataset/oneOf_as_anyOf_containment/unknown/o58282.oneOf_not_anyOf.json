  "definitions3": {
    "Audio": {
      "description": "Audio options",
      "properties": {
        "formats": {
          "default": [
            "mp3",
            "mp4",
            "m4a",
            "aac",
            "flac",
            "wav",
            "ogg",
            "3gpp"
          ],
          "description": "Supported audio formats",
          "items": {
            "type": "string",
            "_uniqueItems": true
          },
          "type": "array"
        },
        "mute": {
          "default": false,
          "description": "Toggle audio output",
          "type": "boolean"
        },
        "volume": {
          "default": 0.5,
          "description": "Playback volume (0 = silent, 1 = maximum)",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "Download": {
      "additionalProperties": false,
      "description": "Download manager options",
      "properties": {
        "concurrency": {
          "default": 1,
          "description": "Limits the number of concurrent operations.",
          "maximum": 10,
          "minimum": 1,
          "type": "number"
        },
        "force": {
          "default": false,
          "description": "Force overwrite without prompt when output file name already exists",
          "type": "boolean"
        },
        "notifications": {
          "description": "Notification options",
          "properties": {
            "completed": {
              "default": true,
              "description": "Notify when download has finished",
              "type": "boolean"
            },
            "error": {
              "default": true,
              "description": "Notify when download has failed",
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "preview": {
          "description": "Media preview options",
          "properties": {
            "bufferDuration": {
              "default": 30,
              "description": "Buffer duration, in seconds",
              "minimum": 1
            }
          },
          "type": "object"
        },
        "rename": {
          "default": null,
          "description": "Custom file naming rules",
          "type": [
            "string",
            "null"
          ]
        },
        "savePath": {
          "$ref": "#/definitions3/Path",
          "default": "downloads",
          "description": "The output directory to hold the downloaded files"
        },
        "tempPath": {
          "$ref": "#/definitions3/Path",
          "default": "temp",
          "description": "Temporary output directory directory"
        },
        "transcode": {
          "default": false,
          "description": "Media transcoding options",
          "oneOf": [
            {
              "$ref": "#/definitions3/Transcoder"
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "required": [
        "savePath",
        "tempPath"
      ],
      "type": "object"
    },
    "FileExtensions": {
      "default": [
        "mp3",
        "mp4",
        "m4a",
        "aac",
        "flac",
        "wav",
        "ogg",
        "3gpp"
      ],
      "description": "Supported audio input formats",
      "items": {
        "type": "string",
        "_uniqueItems": true
      },
      "type": "array"
