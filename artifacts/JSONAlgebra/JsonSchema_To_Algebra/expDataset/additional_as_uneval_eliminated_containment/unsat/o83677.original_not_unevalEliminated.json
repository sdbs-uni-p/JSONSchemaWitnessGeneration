            "type": "string"
          },
          "type": "array"
        },
        "parts": {
          "$ref": "#/definitions3/Parts"
        },
        "path": {
          "pattern": "^\\/([a-z0-9\\/_{}])*$",
          "type": "string"
        }
      },
      "required": [
        "methods",
        "path"
      ],
      "title": "API path",
      "type": "object"
    },
    "Url": {
      "additionalProperties": false,
      "description": "An array of the URL path variants for the API",
      "properties": {
        "paths": {
          "items": {
