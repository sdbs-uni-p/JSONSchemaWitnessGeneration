  "definitions3": {
    "dataset": {
      "description": "Files in the archive that contain the data of interest",
      "items": {
        "description": "Use 'data:<mime-type>[;base64],<...>' for data URIs, 'file:<...>' for file references, and 'http://<host>/<file>' for external references.",
